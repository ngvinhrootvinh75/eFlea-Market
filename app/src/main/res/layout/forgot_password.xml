<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="55dp"
            android:background="@drawable/bg_circle_logo"
            android:contentDescription="@string/app_name"
            android:padding="18dp"
            android:src="@drawable/ic_shopping_cart"
            app:tint="#0F766E" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="eFleaMarket"
            android:textColor="#0F766E"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="88dp"
            android:text="QUÊN MẬT KHẨU?"
            android:textColor="#0F766E"
            android:textSize="27sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <EditText
            android:id="@+id/etResetEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="8dp"
            android:autofillHints="emailAddress"
            android:backgroundTint="#0F766E"
            android:hint="Nhập email "
            android:inputType="textEmailAddress"
            android:padding="12dp"
            android:textColor="#222222"
            android:textColorHint="#999999"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnSendResetEmail"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#0F766E"
            android:text="GỬI LIÊN KẾT ĐẶT LẠI MẬT KHẨU"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/tvBackToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:padding="8dp"
            android:text="← Quay lại đăng nhập"
            android:textColor="#0F766E"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
